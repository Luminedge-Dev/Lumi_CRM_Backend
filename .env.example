# Copy to .env and fill in real values. Never commit .env. Every value below is a placeholder.
# All of these are read in ONE place: src/config/env.ts.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Required in production (there is no production fallback).
# Use a LOCAL database for development and scripts; the maintenance scripts refuse non-local
# targets for writes unless --confirm-production is passed (see src/scripts/README.md).
MONGODB_URI=mongodb://localhost:27017/your_local_database

# Long random string used to sign login tokens. Required.
JWT_SECRET=replace-with-a-long-random-secret

# Browser origins allowed to call the API (comma separated). FRONTEND_URL is also trusted and is
# used for links inside emails.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Google sign-in: the OAuth client ID your frontend uses. Google sign-in is refused when unset.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email (password reset and setup links)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# Document uploads: Vercel Blob token. In production uploads are refused when unset.
BLOB_READ_WRITE_TOKEN=

# Split deployment only: API forwards notifications to a separate socket host.
SOCKET_SERVER_URL=
SOCKET_SERVER_SECRET=

# Render only: public URL used by the keep-alive self-ping (production).
RENDER_EXTERNAL_URL=

# Used only by the one-off seed scripts (src/scripts), never by the API.
SEED_ADMIN_EMAIL=
SEED_BDM_EMAIL=
SEED_SENIOR_BDM_EMAIL=
SEED_JUNIOR_BDM_EMAIL=
SEED_EMAIL=
SEED_NAME=
SEED_ROLE=
SEED_PASSWORD=
